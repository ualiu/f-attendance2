<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StaffLogix - AI-Powered Attendance Management</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/style.css" />
    <style>
      /* Palette. --surface is derived from --text-primary at low alpha so
         raised panels stay on the same colour axis as everything else. */
      :root {
        --background: #000f0d;
        --text-primary: #f6f7f6;
        --text-secondary: #b6bbb7;
        --border: rgba(246, 247, 246, 0.22);
        --border-strong: rgba(246, 247, 246, 0.9);
        --surface: rgba(246, 247, 246, 0.04);
        --surface-raised: rgba(246, 247, 246, 0.07);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        height: 100%;
        overflow-x: hidden;
      }

      /* Only 400/500/600/700 are shipped - never exceed 700 or the browser
         synthesises a faux bold. */
      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          "Helvetica Neue",
          Arial,
          sans-serif;
        line-height: 1.6;
        color: var(--text-primary);
        background: var(--background);
        min-height: 100%;
        margin: 0;
        overflow-x: hidden;
        width: 100%;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .landing-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        width: 100%;
        overflow-x: hidden;
      }

      /* Navigation */
      .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 5%;
        background: var(--background);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
        flex-shrink: 0;
      }

      .logo {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.02em;
      }

      .nav-links a {
        color: var(--text-primary);
        text-decoration: none;
        padding: 0.625rem 1.5rem;
        border-radius: 6px;
        font-weight: 500;
        transition: all 0.2s;
        border: 1px solid var(--border-strong);
        display: inline-block;
      }

      .nav-links a:hover {
        background: var(--text-primary);
        color: var(--background);
      }

      /* Hero */
      .hero {
        text-align: center;
        padding: 5rem 5% 4rem;
        flex-shrink: 0;
      }

      /* Eyebrow - carries the product category so the h1 is free to sell the
         benefit. Letter-spacing is positive here, unlike the tight h1.
         Must be scoped to .hero: a bare .eyebrow (0,1,0) loses to .hero p
         (0,1,1) and would inherit the paragraph size and margin. */
      .hero .eyebrow {
        font-size: 0.8125rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--text-secondary);
        margin-bottom: 1.25rem;
      }

      .hero h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        margin-bottom: 1.5rem;
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.03em;
        color: var(--text-primary);
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      .hero p {
        font-size: clamp(1.0625rem, 2.5vw, 1.25rem);
        margin: 0 auto 2.5rem;
        color: var(--text-secondary);
        max-width: 620px;
        line-height: 1.7;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      /* Industry ticker - one continuous line naming who this is built for.
         The track holds two identical copies of the list and translates by
         exactly -50%, so copy two lands where copy one started and the loop
         is seamless with no visible jump. */
      .industries {
        padding: 0 0 2.5rem;
        overflow: hidden;
        flex-shrink: 0;
        /* Fade both edges into the background rather than hard-cutting a
           word at the viewport edge. */
        -webkit-mask-image: linear-gradient(
          90deg,
          transparent,
          #000 10%,
          #000 90%,
          transparent
        );
        mask-image: linear-gradient(
          90deg,
          transparent,
          #000 10%,
          #000 90%,
          transparent
        );
      }

      .industries-track {
        display: flex;
        width: max-content;
        animation: industryScroll 38s linear infinite;
      }

      /* Let a reader stop the line to actually read it. */
      .industries:hover .industries-track {
        animation-play-state: paused;
      }

      .industries-group {
        display: flex;
        flex-shrink: 0;
      }

      .industry {
        display: flex;
        align-items: center;
        gap: 2.25rem;
        padding-right: 2.25rem;
        font-size: 0.8125rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--text-secondary);
        white-space: nowrap;
      }

      /* Separator dot rides after every item, including the last one - that
         is what keeps the spacing even across the seam between copies. */
      .industry::after {
        content: "";
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--text-secondary);
        opacity: 0.45;
        flex-shrink: 0;
      }

      @keyframes industryScroll {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }

      /* No motion: drop the duplicate copy and let the single list wrap and
         centre as a static line instead of scrolling. */
      @media (prefers-reduced-motion: reduce) {
        .industries {
          -webkit-mask-image: none;
          mask-image: none;
          padding: 0 5% 2.5rem;
        }

        .industries-track {
          animation: none;
          width: 100%;
        }

        .industries-group {
          flex-wrap: wrap;
          justify-content: center;
        }

        .industries-group[aria-hidden="true"] {
          display: none;
        }
      }

      /* Demo */
      .demo {
        padding: 1rem 5% 5rem;
        flex-shrink: 0;
      }

      .demo-frame {
        max-width: 740px;
        margin: 0 auto;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
      }

      .demo-titlebar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: var(--surface-raised);
        border-bottom: 1px solid var(--border);
      }

      .demo-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--border);
        flex-shrink: 0;
      }

      .demo-title {
        margin-left: 0.5rem;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-secondary);
      }

      .demo-body {
        padding: 1.5rem;
        font-family: "SF Mono", Menlo, Consolas, "Courier New", monospace;
        font-size: 0.8125rem;
        line-height: 1.65;
        color: var(--text-primary);
        /* Grid, with every slide stacked in the same cell (see .demo-slide
           below) - the row sizes to the TALLEST slide regardless of which
           one is active, so the frame no longer changes height when you
           flip between a 4-message and a 3-message example. */
        display: grid;
        /* Swipe is handled by JS (touchstart/move/end); this tells the
           browser vertical scrolling is still native while horizontal
           gestures are ours to interpret, so a swipe doesn't fight the
           page scroll. */
        touch-action: pan-y;
      }

      .demo-head {
        color: var(--text-secondary);
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
        border-bottom: 1px solid var(--border);
      }

      /* Chat bubbles. Font switches to the site's normal sans here - the
         monospace above is for the log-style header block, but a text
         message rendered in monospace reads as a terminal, not a phone. */
      .demo-msg {
        display: flex;
        flex-direction: column;
        margin-bottom: 1rem;
        max-width: 100%;
      }

      .demo-msg:last-child {
        margin-bottom: 0;
      }

      /* Employee = the other party, left side (received). System = the
         business's own automated texts, right side (sent) - the usual
         messaging-app convention. */
      .demo-msg.is-employee {
        align-items: flex-start;
      }

      .demo-msg.is-system {
        align-items: flex-end;
      }

      .demo-meta {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
        color: var(--text-secondary);
        font-size: 0.6875rem;
        margin-bottom: 0.3rem;
        padding: 0 0.3rem;
      }

      .demo-bubble {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
        max-width: 82%;
        padding: 0.625rem 0.875rem;
        border-radius: 16px;
        font-size: 0.8125rem;
        line-height: 1.5;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      .demo-msg.is-employee .demo-bubble {
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-bottom-left-radius: 4px;
        color: var(--text-primary);
      }

      .demo-msg.is-system .demo-bubble {
        background: rgba(74, 222, 128, 0.14);
        border: 1px solid rgba(74, 222, 128, 0.35);
        border-bottom-right-radius: 4px;
        color: var(--text-primary);
      }

      /* Carousel */
      .demo-caption {
        font-size: 0.8125rem;
        font-weight: 600;
        color: #4ade80;
        letter-spacing: 0.02em;
        margin-bottom: 1rem;
      }

      .demo-slide {
        /* All three stack in the same grid cell (see .demo-body) - this is
           what makes the frame's height driven by the tallest slide instead
           of whichever one happens to be active. visibility (not
           display:none) keeps inactive slides counted for that sizing while
           still removing them from tab order / assistive tech / clicks. */
        grid-row: 1;
        grid-column: 1;
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        min-width: 0;
      }

      .demo-slide.is-active {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
        animation: demoFadeIn 0.35s ease;
      }

      @keyframes demoFadeIn {
        from {
          opacity: 0;
          transform: translateY(4px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .demo-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        margin-top: 1.5rem;
      }

      .demo-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-primary);
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
      }

      .demo-arrow:hover {
        border-color: var(--border-strong);
        background: var(--surface);
      }

      .demo-dots-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .carousel-dot {
        width: 8px;
        height: 8px;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: var(--border);
        cursor: pointer;
        transition: all 0.2s;
      }

      .carousel-dot.is-active {
        width: 20px;
        border-radius: 4px;
        background: #4ade80;
      }

      @media (hover: none) and (pointer: coarse) {
        .demo-arrow {
          min-height: 44px;
          min-width: 44px;
        }
      }

      /* Features */
      .features {
        padding: 4rem 5% 5rem;
        border-top: 1px solid var(--border);
        flex: 1;
      }

      .features h2 {
        text-align: center;
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        margin-bottom: 0.75rem;
        color: var(--text-primary);
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      /* Supporting line under the section heading. It takes over the 3rem gap
         the h2 used to own, so the distance down to the cards is unchanged;
         h2 keeps the same tight 0.75rem to its subhead as .cta-section does. */
      .features-subhead {
        text-align: center;
        color: var(--text-secondary);
        max-width: 520px;
        margin: 0 auto 3rem;
        font-size: 1rem;
        line-height: 1.7;
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: 1.5rem;
        max-width: 1100px;
        margin: 0 auto;
      }

      .feature-card {
        padding: 2rem 1.5rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        transition: all 0.25s;
      }

      .feature-card:hover {
        transform: translateY(-4px);
        border-color: var(--border-strong);
      }

      /* Step line rather than icons - "How It Works" is a sequence, so the
         numeral carries the step ("01 · EMPLOYEE TEXTS") and the h3 below is
         free to carry the benefit. Same letter-spaced treatment as the hero
         eyebrow, so it stays on the page's typographic system. */
      .feature-step {
        display: block;
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--text-secondary);
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
      }

      .feature-card h3 {
        font-size: 1.1875rem;
        margin-bottom: 0.75rem;
        color: var(--text-primary);
        font-weight: 600;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      .feature-card p {
        color: var(--text-secondary);
        line-height: 1.7;
        font-size: 0.9375rem;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      /* Closing CTA */
      .cta-section {
        text-align: center;
        padding: 5rem 5%;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
      }

      .cta-section h2 {
        font-size: clamp(1.5rem, 3.5vw, 2rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
      }

      .cta-section p {
        color: var(--text-secondary);
        max-width: 520px;
        margin: 0 auto 2rem;
        font-size: 1rem;
        line-height: 1.7;
      }

      /* Pill variant - outlined rather than filled so it reads as a softer,
         secondary ask than the hero button. */
      .cta-button-outline {
        display: inline-block;
        padding: 0.8125rem 2rem;
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        color: var(--text-primary);
        background: transparent;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9375rem;
        transition: all 0.2s;
        touch-action: manipulation;
      }

      .cta-button-outline:hover {
        background: var(--text-primary);
        color: var(--background);
      }

      /* Footer */
      .footer {
        text-align: center;
        padding: 2rem 5%;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
        margin-top: auto;
      }

      .footer p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.875rem;
      }

      /* Mobile Optimizations */
      @media (max-width: 768px) {
        .navbar {
          padding: 1rem 4%;
        }

        .logo {
          font-size: 1.25rem;
        }

        .nav-links a {
          padding: 0.5rem 1.25rem;
          font-size: 0.9375rem;
        }

        .hero {
          padding: 3.5rem 4% 3rem;
        }

        .demo {
          padding: 1rem 4% 3.5rem;
        }

        .features {
          padding: 3rem 4%;
        }

        .cta-section {
          padding: 3.5rem 4%;
        }

        .features h2 {
          margin-bottom: 0.75rem;
        }

        .features-subhead {
          margin-bottom: 2rem;
        }

        .features-grid {
          grid-template-columns: 1fr;
          gap: 1.25rem;
        }

        .feature-card {
          padding: 1.75rem 1.25rem;
        }

        .footer {
          padding: 1.75rem 4%;
        }
      }

      @media (max-width: 480px) {
        .navbar {
          padding: 0.875rem 5%;
        }

        .logo {
          font-size: 1.125rem;
        }

        .nav-links a {
          padding: 0.5rem 1rem;
          font-size: 0.875rem;
        }

        .hero {
          padding: 3rem 5% 2.5rem;
        }

        .demo {
          padding: 1rem 5% 3rem;
        }

        .demo-body {
          padding: 1.25rem 1rem;
          font-size: 0.75rem;
        }

        .features {
          padding: 2.5rem 5%;
        }

        .cta-section {
          padding: 3rem 5%;
        }

        .cta-button-outline {
          width: 100%;
          max-width: 320px;
        }

        .features-grid {
          gap: 1rem;
        }

        .feature-card {
          padding: 1.5rem 1rem;
        }

        .footer {
          padding: 1.5rem 5%;
        }
      }

      @media (max-width: 375px) {
        .navbar {
          padding: 0.75rem 4%;
        }

        .logo {
          font-size: 1rem;
        }

        .nav-links a {
          padding: 0.5rem 0.875rem;
          font-size: 0.8125rem;
        }

        .hero {
          padding: 2.5rem 4% 2rem;
        }

        .hero .eyebrow {
          font-size: 0.75rem;
          letter-spacing: 0.12em;
          margin-bottom: 1rem;
        }

        .hero h1 {
          font-size: 1.625rem;
        }

        .cta-button-outline {
          padding: 0.75rem 1.5rem;
          font-size: 0.875rem;
        }

        .demo-body {
          padding: 1rem 0.875rem;
        }

        .features {
          padding: 2rem 4%;
        }

        .feature-card {
          padding: 1.25rem 0.875rem;
        }

        .feature-card h3 {
          font-size: 1.0625rem;
        }

        .feature-card p {
          font-size: 0.9375rem;
        }

        .footer {
          padding: 1.25rem 4%;
        }

        .footer p {
          font-size: 0.8125rem;
        }
      }

      /* Touch device optimizations */
      @media (hover: none) and (pointer: coarse) {
        .cta-button-outline,
        .nav-links a {
          min-height: 44px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
        }

        .feature-card:hover,
        .cta-button-outline:hover {
          transform: none;
        }
      }

      /* Landscape phone optimization */
      @media (max-height: 500px) and (orientation: landscape) {
        .hero {
          padding: 2rem 5%;
        }

        .hero h1 {
          margin-bottom: 1rem;
        }

        .hero p {
          margin-bottom: 1.5rem;
        }
      }
    </style>
  </head>
  <body class="landing-page">
    <nav class="navbar">
      <div class="logo">StaffLogix</div>
      <div class="nav-links">
        <a href="/login">Login</a>
      </div>
    </nav>

    <section class="hero">
      <p class="eyebrow">AI-powered workforce coordination</p>
      <h1>Automate employee call-ins & shift coverage with SMS</h1>
      <p>
        AI assistant handles employee call-ins, finds coworkers to cover open
        shifts, and keeps managers in control.
      </p>
      <a href="/contact" class="cta-button-outline">Talk to us</a>
    </section>

    <!-- Industries. The second .industries-group is a visual duplicate that
         makes the scroll seamless - aria-hidden so it isn't read twice. -->
    <section class="industries">
      <div class="industries-track">
        <div class="industries-group">
          <span class="industry">Warehousing</span>
          <span class="industry">Healthcare</span>
          <span class="industry">Senior Care</span>
          <span class="industry">Retail</span>
          <span class="industry">Grocery Stores</span>
          <span class="industry">Restaurants</span>
          <span class="industry">Pizza Stores</span>
          <span class="industry">Hotels</span>
        </div>
        <div class="industries-group" aria-hidden="true">
          <span class="industry">Warehousing</span>
          <span class="industry">Healthcare</span>
          <span class="industry">Senior Care</span>
          <span class="industry">Retail</span>
          <span class="industry">Grocery Stores</span>
          <span class="industry">Restaurants</span>
          <span class="industry">Pizza Stores</span>
          <span class="industry">Hotels</span>
        </div>
      </div>
    </section>

    <section class="demo">
      <div class="demo-frame">
        <div class="demo-titlebar">
          <span class="demo-dot"></span>
          <span class="demo-dot"></span>
          <span class="demo-dot"></span>
          <span class="demo-title">SMS Conversation Sample</span>
        </div>

        <div class="demo-body" id="demoBody">
          <!-- Slide 1: the absence is reported -->
          <div class="demo-slide is-active">
            <p class="demo-caption">1 &middot; Employee reports the absence</p>
            <!-- <div class="demo-head">
              Employee: John Doe<br />
              Date: Monday 2026-08-03<br />
              Method: SMS
            </div> -->

            <div class="demo-msg is-employee">
              <div class="demo-meta">👤 Employee · 8:58:52 PM</div>
              <div class="demo-bubble">I can't come in tomorrow</div>
            </div>

            <div class="demo-msg is-system">
              <div class="demo-meta">🤖 System · 8:58:54 PM</div>
              <div class="demo-bubble">
                Hi John, what's the reason? (e.g., appointment, errands, family
                matter)
              </div>
            </div>

            <div class="demo-msg is-employee">
              <div class="demo-meta">👤 Employee · 8:59:05 PM</div>
              <div class="demo-bubble">I have an appointment</div>
            </div>

            <div class="demo-msg is-system">
              <div class="demo-meta">🤖 System · 8:59:07 PM</div>
              <div class="demo-bubble">
                Got it, John. Logged: out all day (personal) tomorrow -
                Appointment. ✅ If that's not right, just reply and tell me what
                to change.
              </div>
            </div>
          </div>

          <!-- Slide 2: the AI finds someone to cover it -->
          <div class="demo-slide">
            <p class="demo-caption">2 &middot; AI finds someone to cover it</p>
            <!-- <div class="demo-head">
              Employee: Mary Jones<br />
              Shift: Day shift, Tomorrow<br />
              Method: SMS
            </div> -->

            <div class="demo-msg is-system">
              <div class="demo-meta">🤖 System · 9:01:12 PM</div>
              <div class="demo-bubble">
                Hi Mary, tomorrow's day shift (7:00 AM - 3:00 PM) at
                Riverside is up for grabs. Reply YES to claim it, or NO
                if you can't.
              </div>
            </div>

            <div class="demo-msg is-employee">
              <div class="demo-meta">👤 Employee · 9:02:03 PM</div>
              <div class="demo-bubble">yes</div>
            </div>

