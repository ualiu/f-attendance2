    <script>
      (function () {
        var slides = document.querySelectorAll("#demoBody .demo-slide");
        var dots = document.querySelectorAll("#demoDotsNav .carousel-dot");
        var prevBtn = document.getElementById("demoPrev");
        var nextBtn = document.getElementById("demoNext");
        var frame = document.querySelector(".demo-frame");
        if (!slides.length) return;

        var index = 0;
        var timer = null;
        var AUTO_MS = 5000;
        var reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        function show(i) {
          index = (i + slides.length) % slides.length;
          slides.forEach(function (slide, n) {
            slide.classList.toggle("is-active", n === index);
          });
          dots.forEach(function (dot, n) {
            dot.classList.toggle("is-active", n === index);
          });
        }

        function next() {
          show(index + 1);
        }
        function prev() {
          show(index - 1);
        }

        function stopAuto() {
          if (timer) clearInterval(timer);
        }

        function startAuto() {
          stopAuto();
          if (reduceMotion) return; // respect the user's motion preference - no forced auto-advance
          timer = setInterval(next, AUTO_MS);
        }

        dots.forEach(function (dot, n) {
          dot.addEventListener("click", function () {
            show(n);
            startAuto();
          });
        });

        if (nextBtn)
          nextBtn.addEventListener("click", function () {
            next();
            startAuto();
          });
        if (prevBtn)
          prevBtn.addEventListener("click", function () {
            prev();
            startAuto();
          });

        // Pause auto-advance while a visitor is actually reading a slide.
        if (frame) {
          frame.addEventListener("mouseenter", stopAuto);
          frame.addEventListener("mouseleave", startAuto);
        }

        // Touch swipe (mobile) - tap-and-drag anywhere on the frame, in
        // addition to the arrow buttons. A swipe must move further
        // horizontally than vertically before we treat it as a swipe rather
        // than the visitor just scrolling the page past the carousel.
        if (frame) {
          var touchStartX = 0,
            touchStartY = 0,
            touchDeltaX = 0,
            touchDeltaY = 0,
            swiping = false;
          var SWIPE_THRESHOLD = 40;

          frame.addEventListener(
            "touchstart",
            function (e) {
              var t = e.touches[0];
              touchStartX = t.clientX;
              touchStartY = t.clientY;
              touchDeltaX = 0;
              touchDeltaY = 0;
              swiping = false;
              stopAuto();
            },
            { passive: true },
          );

          frame.addEventListener(
            "touchmove",
            function (e) {
              var t = e.touches[0];
              touchDeltaX = t.clientX - touchStartX;
              touchDeltaY = t.clientY - touchStartY;
              if (Math.abs(touchDeltaX) > Math.abs(touchDeltaY)) {
                swiping = true;
                e.preventDefault(); // horizontal swipe - don't let the page scroll fight it
              }
            },
            { passive: false },
          );

          frame.addEventListener("touchend", function () {
            if (swiping && Math.abs(touchDeltaX) > SWIPE_THRESHOLD) {
              if (touchDeltaX < 0) next();
              else prev(); // swipe left -> next, right -> prev
            }
            swiping = false;
            startAuto();
          });
        }

        show(0);
        startAuto();
      })();
    </script>
